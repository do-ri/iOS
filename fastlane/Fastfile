default_platform(:ios)

platform :ios do

  # App Store Connect API Key 설정
  def setup_api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )
  end

  # -----------------------------------------------
  # TestFlight 배포
  # -----------------------------------------------
  desc "TestFlight에 빌드 업로드"
  lane :beta do
    setup_api_key

    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "Projects/App/Dori-iOS.xcodeproj"
    )

    build_app(
      workspace: "Dori-iOS.xcworkspace",
      scheme: "DoriApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.arex.dori" => "Dori App Store"
        }
      },
      xcargs: "-skipMacroValidation"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )

    discord_notifier(
      webhook_url: ENV["DISCORD_WEBHOOK_URL"],
      title: "✅ Dori TestFlight 배포 완료",
      description: "빌드 번호: #{get_build_number}\n브랜치: #{git_branch}\n커밋: #{last_git_commit[:message]}",
      success: true
    )
  end

  # -----------------------------------------------
  # 에러 핸들링
  # -----------------------------------------------
  error do |lane, exception|
    discord_notifier(
      webhook_url: ENV["DISCORD_WEBHOOK_URL"],
      title: "❌ Dori 배포 실패",
      description: "Lane: #{lane}\n브랜치: #{git_branch}\n원인: #{exception.message}",
      success: false
    )
  end

end
