default_platform(:ios)

platform :ios do

  # App Store Connect API Key 설정
  def setup_api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )
  end

  # -----------------------------------------------
  # TestFlight 배포 (feature → develop 병합 시)
  # 대상: 도리팀 외부 그룹
  # -----------------------------------------------
  desc "TestFlight 도리팀 배포"
  lane :beta do
    setup_ci if ENV["CI"]
    setup_api_key

    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "Projects/App/Dori-iOS.xcodeproj"
    )

    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV["ASC_KEY_ID"]}.p8")

    team_id = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    profile_name = ENV["PROVISIONING_PROFILE_SPECIFIER"]
    export_options_path = File.expand_path("../ExportOptions.plist", __FILE__)
    File.write(export_options_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>teamID</key>
        <string>#{team_id}</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>#{app_id}</key>
          <string>#{profile_name}</string>
        </dict>
        <key>stripSwiftSymbols</key>
        <true/>
        <key>uploadBitcode</key>
        <false/>
        <key>uploadSymbols</key>
        <true/>
      </dict>
      </plist>
    PLIST

    # Archive only — fastlane's export step rewrites the export plist by
    # scanning the archive's embedded bundles, which forces every framework
    # into the provisioningProfiles dict and breaks export. We export
    # ourselves below.
    build_app(
      workspace: "Dori-iOS.xcworkspace",
      scheme: "DoriApp",
      configuration: "Release",
      skip_package_ipa: true,
      output_directory: "build",
      xcargs: "-skipMacroValidation"
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    UI.user_error!("Archive path not found in lane_context") if archive_path.nil? || archive_path.empty?
    ipa_dir = File.expand_path("../build", __FILE__)
    FileUtils.mkdir_p(ipa_dir)

    sh("xcodebuild", "-exportArchive",
       "-archivePath", archive_path,
       "-exportOptionsPlist", export_options_path,
       "-exportPath", ipa_dir,
       "-allowProvisioningUpdates")

    ipa_path = Dir.glob(File.join(ipa_dir, "*.ipa")).first
    UI.user_error!("No IPA produced in #{ipa_dir}") if ipa_path.nil?

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      groups: ["도리팀"],
      distribute_external: true,
      changelog: last_git_commit[:message]
    )

    discord_notifier(
      webhook_url: ENV["DISCORD_WEBHOOK_URL"],
      title: "✅ Dori TestFlight 배포 완료",
      description: "빌드 번호: #{get_build_number}\n브랜치: #{git_branch}\n커밋: #{last_git_commit[:message]}",
      success: true
    )
  end

  # -----------------------------------------------
  # App Store 빌드 등록 (git tag 푸시 시)
  # 심사 제출은 App Store Connect에서 수동으로
  # -----------------------------------------------
  desc "App Store 빌드 등록"
  lane :release do
    setup_api_key

    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "Projects/App/Dori-iOS.xcodeproj"
    )

    build_app(
      workspace: "Dori-iOS.xcworkspace",
      scheme: "DoriApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: CredentialsManager::AppfileConfig.try_fetch_value(:team_id),
        provisioningProfiles: {
          CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier) => ENV["PROVISIONING_PROFILE_SPECIFIER"]
        },
        stripSwiftSymbols: true,
        uploadBitcode: false,
        uploadSymbols: true
      },
      xcargs: "-skipMacroValidation -allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_app_store(
      submit_for_review: false,
      skip_screenshots: true,
      skip_metadata: true
    )

    discord_notifier(
      webhook_url: ENV["DISCORD_WEBHOOK_URL"],
      title: "✅ Dori App Store 빌드 등록 완료",
      description: "빌드 번호: #{get_build_number}\n태그: #{last_git_tag}\n심사 제출은 App Store Connect에서 수동으로 진행해주세요.",
      success: true
    )
  end

  # -----------------------------------------------
  # 에러 핸들링
  # -----------------------------------------------
  error do |lane, exception|
    discord_notifier(
      webhook_url: ENV["DISCORD_WEBHOOK_URL"],
      title: "❌ Dori 배포 실패 (#{lane})",
      description: "브랜치: #{git_branch}\n원인: #{exception.message}",
      success: false
    )
  end

end
