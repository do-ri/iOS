default_platform(:ios)

platform :ios do

  # App Store Connect API Key 설정
  def setup_api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )
  end

  # -----------------------------------------------
  # TestFlight 배포 (feature → develop 병합 시)
  # 대상: 도리팀 외부 그룹
  # -----------------------------------------------
  desc "TestFlight 도리팀 배포"
  lane :beta do
    setup_ci if ENV["CI"]
    setup_api_key

    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "Projects/App/Dori-iOS.xcodeproj"
    )

    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV["ASC_KEY_ID"]}.p8")

    build_app(
      workspace: "Dori-iOS.xcworkspace",
      scheme: "DoriApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.arex.dori" => ENV["PROVISIONING_PROFILE_SPECIFIER"]
        }
      },
      xcargs: "-skipMacroValidation -allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{ENV["ASC_KEY_ID"]} -authenticationKeyIssuerID #{ENV["ASC_ISSUER_ID"]}",
      export_xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{ENV["ASC_KEY_ID"]} -authenticationKeyIssuerID #{ENV["ASC_ISSUER_ID"]}"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      groups: ["도리팀"]
    )

    discord_notifier(
      webhook_url: ENV["DISCORD_WEBHOOK_URL"],
      title: "✅ Dori TestFlight 배포 완료",
      description: "빌드 번호: #{get_build_number}\n브랜치: #{git_branch}\n커밋: #{last_git_commit[:message]}",
      success: true
    )
  end

  # -----------------------------------------------
  # App Store 빌드 등록 (git tag 푸시 시)
  # 심사 제출은 App Store Connect에서 수동으로
  # -----------------------------------------------
  desc "App Store 빌드 등록"
  lane :release do
    setup_api_key

    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "Projects/App/Dori-iOS.xcodeproj"
    )

    build_app(
      workspace: "Dori-iOS.xcworkspace",
      scheme: "DoriApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.arex.dori" => ENV["PROVISIONING_PROFILE_SPECIFIER"]
        }
      },
      xcargs: "-skipMacroValidation -allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_app_store(
      submit_for_review: false,
      skip_screenshots: true,
      skip_metadata: true
    )

    discord_notifier(
      webhook_url: ENV["DISCORD_WEBHOOK_URL"],
      title: "✅ Dori App Store 빌드 등록 완료",
      description: "빌드 번호: #{get_build_number}\n태그: #{last_git_tag}\n심사 제출은 App Store Connect에서 수동으로 진행해주세요.",
      success: true
    )
  end

  # -----------------------------------------------
  # 에러 핸들링
  # -----------------------------------------------
  error do |lane, exception|
    discord_notifier(
      webhook_url: ENV["DISCORD_WEBHOOK_URL"],
      title: "❌ Dori 배포 실패 (#{lane})",
      description: "브랜치: #{git_branch}\n원인: #{exception.message}",
      success: false
    )
  end

end
